<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sutra â€” AutoCAD & Civil 3D MCP add-in (Scio.Cad).
    Mirrors Scio.Revit's multi-year single-project design:
      2023-2024  .NET Framework 4.8   net48
      2025-2026  .NET 8               net8.0-windows7.0

    AutoCAD managed assemblies (accoremgd, acdbmgd, acmgd, AdWindows) are
    referenced with Private=false; AutoCAD/Civil 3D provides them at load time.
    Civil 3D (AeccDbMgd.dll) is detected and invoked dynamically at runtime so
    the exact same binary loads cleanly in both plain AutoCAD and Civil 3D.
  -->
  <PropertyGroup>
    <CadYear Condition="'$(CadYear)' == ''">2025</CadYear>
    <CadDir Condition="'$(CadDir)' == ''">C:\Program Files\Autodesk\AutoCAD $(CadYear)</CadDir>
    <!--
      AutoCAD / Civil 3D 2025.0-2025.1 and 2026.0 run on .NET 8 (net8.0-windows), while later updates
      (e.g. AutoCAD 2025.1.x / 2026.1.x) migrated to .NET 10. A net8.0-windows add-in loads cleanly on
      BOTH .NET 8 and .NET 10 AutoCAD hosts, whereas a net10.0-windows add-in fails silently on .NET 8
      hosts. On machines with .NET 10 AutoCAD updates installed, local acdbmgd.dll references
      System.Runtime 10.0.0.0 (CS1705 under net8.0-windows), so for net8.0-windows (and CI/missing
      local installs) we compile against the official net8.0 AutoCAD.NET NuGet packages.
    -->
    <TargetFramework Condition="$(CadYear) &lt;= 2024">net48</TargetFramework>
    <TargetFramework Condition="$(CadYear) == 2025 or $(CadYear) == 2026">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(CadYear) &gt;= 2027">net10.0-windows</TargetFramework>
    <AutoCadNetVersion Condition="'$(CadYear)' == '2023'">24.2.0</AutoCadNetVersion>
    <AutoCadNetVersion Condition="'$(CadYear)' == '2024'">24.3.0</AutoCadNetVersion>
    <AutoCadNetVersion Condition="'$(CadYear)' == '2025'">25.0.0</AutoCadNetVersion>
    <AutoCadNetVersion Condition="'$(CadYear)' == '2026'">25.1.0</AutoCadNetVersion>
    <AutoCadNetVersion Condition="'$(AutoCadNetVersion)' == ''">26.0.0</AutoCadNetVersion>
    <UseLocalCadApi Condition="'$(UseLocalCadApi)' == '' and '$(TargetFramework)' != 'net8.0-windows' and Exists('$(CadDir)\acdbmgd.dll') and Exists('$(CadDir)\accoremgd.dll') and Exists('$(CadDir)\acmgd.dll') and Exists('$(CadDir)\AdWindows.dll')">true</UseLocalCadApi>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Scio.Cad</AssemblyName>
    <RootNamespace>Scio.Cad</RootNamespace>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>ACAD$(CadYear)</DefineConstants>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <EnableSourceLink>false</EnableSourceLink>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ScioCadYear" Value="$(CadYear)" />
    <SourceRoot Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalCadApi)' == 'true'">
    <Reference Include="accoremgd">
      <HintPath>$(CadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(CadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(CadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(CadDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalCadApi)' != 'true'">
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCadNetVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="$(AutoCadNetVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="$(AutoCadNetVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Shared helpers live in Shared\ (auto-included by SDK-style glob) -->

  <!-- Official Sutra icons embedded directly so Scio.Cad.dll is 100% self-contained. -->
  <ItemGroup>
    <EmbeddedResource Include="Icons\status16.png" LogicalName="Scio.Cad.Icons.status16.png" />
    <EmbeddedResource Include="Icons\status32.png" LogicalName="Scio.Cad.Icons.status32.png" />
    <EmbeddedResource Include="Icons\connect16.png" LogicalName="Scio.Cad.Icons.connect16.png" />
    <EmbeddedResource Include="Icons\connect32.png" LogicalName="Scio.Cad.Icons.connect32.png" />
    <EmbeddedResource Include="Icons\audit16.png" LogicalName="Scio.Cad.Icons.audit16.png" />
    <EmbeddedResource Include="Icons\audit32.png" LogicalName="Scio.Cad.Icons.audit32.png" />
    <EmbeddedResource Include="Icons\censo16.png" LogicalName="Scio.Cad.Icons.censo16.png" />
    <EmbeddedResource Include="Icons\censo32.png" LogicalName="Scio.Cad.Icons.censo32.png" />
    <EmbeddedResource Include="Icons\metrado16.png" LogicalName="Scio.Cad.Icons.metrado16.png" />
    <EmbeddedResource Include="Icons\metrado32.png" LogicalName="Scio.Cad.Icons.metrado32.png" />
    <EmbeddedResource Include="Icons\salidas16.png" LogicalName="Scio.Cad.Icons.salidas16.png" />
    <EmbeddedResource Include="Icons\salidas32.png" LogicalName="Scio.Cad.Icons.salidas32.png" />
  </ItemGroup>

</Project>

